# Module 00c -- a real systemd USER unit (no root/sudo needed at all --
# see DECISIONS.md for why this course uses --user units instead of
# system-wide ones). Install with:
#
#   mkdir -p ~/.config/systemd/user
#   mkdir -p ~/module00c-demo
#   cp heartbeat.sh ~/module00c-demo/
#   chmod +x ~/module00c-demo/heartbeat.sh
#   cp heartbeat.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user start heartbeat.service

[Unit]
Description=Module 00c heartbeat demo service

[Service]
Type=simple
ExecStart=%h/module00c-demo/heartbeat.sh
Restart=on-failure

[Install]
WantedBy=default.target
