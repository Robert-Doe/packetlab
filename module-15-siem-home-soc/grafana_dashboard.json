      "targets": [
        {
          "query": "*",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "terms", "field": "type.keyword", "id": "2" }]
        }
      ]
    },
    {
      "id": 2,
      "title": "Alerts over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
